# =============================================================================
# UKReady Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — NEVER commit real credentials.
#
# For local development: set AI_PROVIDER=anthropic and add your ANTHROPIC_API_KEY.
# AWS credentials are only needed when AI_PROVIDER=bedrock.
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider Selection
# -----------------------------------------------------------------------------
# Options: 'anthropic' (local dev) | 'bedrock' (AWS production) | 'openai'
AI_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic API (for AI_PROVIDER=anthropic — recommended for local dev)
# -----------------------------------------------------------------------------
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use when AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# AWS Bedrock (for AI_PROVIDER=bedrock — production)
# -----------------------------------------------------------------------------
# Only required if AI_PROVIDER=bedrock. Leave blank for local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20251001

# -----------------------------------------------------------------------------
# OpenAI (for AI_PROVIDER=openai — fallback)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# For Docker Compose local dev, use the values below as-is.
DATABASE_URL=postgresql://ukready:ukready_dev_password@postgres:5432/ukready
POSTGRES_USER=ukready
POSTGRES_PASSWORD=ukready_dev_password
POSTGRES_DB=ukready

# -----------------------------------------------------------------------------
# Vector Store (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8001
CHROMA_COLLECTION=ukready_documents

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Set to 'development' or 'production'
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Points to the backend API — in Docker Compose, use the service name
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal URL used by Next.js server-side for API proxying (Docker network)
INTERNAL_API_URL=http://backend:8000
